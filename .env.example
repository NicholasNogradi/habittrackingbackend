# Server
PORT=8080
NODE_ENV=development

# Database (SQLite file path; use ":memory:" for in-memory)
DB_STORAGE=./data/habit-tracker.sqlite

# JWT
JWT_ACCESS_SECRET=change-me-access-secret-please-use-a-long-random-string
JWT_ACCESS_TTL_SECONDS=3600
JWT_ISSUER=https://api.habittrack.io
JWT_AUDIENCE=habittrack-clients

# Refresh tokens
REFRESH_TTL_SECONDS=2592000      # 30 days

# OAuth authorization_code flow (in-memory demo store)
# Comma-separated allowed redirect URIs for the demo client
OAUTH_CLIENT_ID=habittrack-web
OAUTH_CLIENT_SECRET=demo-client-secret
OAUTH_REDIRECT_URIS=https://app.habittrack.io/callback,http://localhost:3000/callback

# Rate limiting
RATE_LIMIT_MAX=1000
RATE_LIMIT_WINDOW_SECONDS=3600
